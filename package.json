{
  "name": "yugioh-combos-trainer",
  "private": true,
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=22.21"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "update-data": "node --disable-warning=ExperimentalWarning --import tsx scripts/update-data.ts",
    "duel": "node --disable-warning=ExperimentalWarning --import tsx scripts/duel-cli.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "postinstall": "patch-package",
    "build:site": "npm run build && node -e \"require('node:fs').cpSync('data/bundle','dist/data',{recursive:true})\""
  },
  "dependencies": {
    "ocgcore-wasm": "0.1.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "patch-package": "^8.0.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
